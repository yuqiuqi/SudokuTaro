{
  "name": "fangcun-sudoku",
  "version": "1.2.5",
  "license": "CC-BY-NC-ND-4.0",
  "private": true,
  "description": "方寸数独 · Fangcun Sudoku — Taro 4 + React，仅 H5（浏览器）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs"
  },
  "taroConfig": {
    "version": "1.0.0",
    "desc": "Fangcun Sudoku CI upload"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "hls.js": "1.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "1.64.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@tarojs/cli": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.0",
    "postcss": "^8.5.31",
    "react-refresh": "^0.14.0",
    "sass": "^1.105.2",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "7.0.2",
    "webpack": "5.91.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
